{
  "name": "catch",
  "version": "0.1.0",
  "description": "Screenshot + voice note in; contacts, follow-ups and tasks out.",
  "scripts": {
    "dev": "node --watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && tsc -p web/tsconfig.sw.json",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:e2e": "node scripts/e2e.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "token": "node scripts/token.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "preact": "^11.1.0",
    "typescript": "5.9",
    "vite": "^8.3.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}
