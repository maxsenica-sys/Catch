# Copy to .env and fill in. Everything except APP_SECRET (in production) is optional:
# without the API keys Catch runs in offline mode and says so on every screen.

# --- Required in production -----------------------------------------------
# Encrypts integration tokens at rest. openssl rand -hex 32. Losing it means
# re-entering every Todoist token, so keep it with your other secrets.
APP_SECRET=
# The https:// address people open. Used in links, the calendar feed URL and
# to decide whether cookies are Secure.
PUBLIC_URL=https://catch.example.com

# --- Reading screenshots (Claude) -------------------------------------------
ANTHROPIC_API_KEY=
# CATCH_MODEL=claude-opus-5-5
# CATCH_EFFORT=medium          # low | medium | high | xhigh | max

# --- Voice notes (OpenAI transcription) --------------------------------------
OPENAI_API_KEY=
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe   # or whisper-1

# --- Who can sign up -----------------------------------------------------------
# The first account is always allowed and becomes the owner.
# open: anyone | invite: needs INVITE_CODE | closed: nobody else
SIGNUP_MODE=invite
INVITE_CODE=

# --- Tuning (defaults shown) ---------------------------------------------------
# PORT=8787
# DATA_DIR=./data
# MAX_UPLOAD_MB=40
# WORKER_CONCURRENCY=2
# TRANSCRIBER=auto             # auto | live | mock
# EXTRACTOR=auto               # auto | live | mock
